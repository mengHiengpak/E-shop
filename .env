# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# In dev the app auto-detects the backend host from the Metro dev server, so
# this value is only a fallback (e.g. web). Set your PC's LAN IP here if the
# auto-detection cannot be used.
EXPO_PUBLIC_URL_BASE = http://192.168.1.26:3000/api
